{
  "manifest_version": 2,
  "id": "octmicy.mai-gatekeeper",
  "name": "麦麦守门人",
  "version": "0.6.5",
  "description": "好友申请审批（LLM 自动 / 管理员人工 / 混合）+ 用户屏蔽（发言拦截、私聊删好友）插件。自建 OneBot v11 正向 WebSocket 直连 NapCat / SnowLuma 对端，无需修改适配器。",
  "author": {
    "name": "octmicy",
    "url": "https://github.com/octmicy"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/octmicy/Mai_gatekeeper",
    "homepage": "https://github.com/octmicy/Mai_gatekeeper",
    "documentation": "https://docs.mai-mai.org"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.6.0",
    "max_version": "2.16.99"
  },
  "dependencies": [],
  "plugin_type": "management",
  "capabilities": [
    "send.text",
    "llm.generate",
    "message.get_by_id",
    "chat.get_stream_by_user_id",
    "chat.open_session",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN",
      "en-US"
    ]
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "mai.png",
      "fallback": "fish",
      "background": "#BFE3F2"
    }
  },
  "changelog": "CHANGELOG.md"
}